{
  "name": "@umituz/web-dashboard",
  "version": "7.8.0",
  "description": "Installable app skeleton for the fleet — layouts, analytics (dependency-free SVG charts), calendar, onboarding flow permissions/module registry; udb-* stylesheet on design-system tokens",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./analytics": "./src/domains/analytics/index.ts",
    "./analytics/components": "./src/domains/analytics/components/index.ts",
    "./analytics/hooks": "./src/domains/analytics/hooks/index.ts",
    "./analytics/services": "./src/domains/analytics/services/index.ts",
    "./analytics/types": "./src/domains/analytics/types/index.ts",
    "./analytics/utils": "./src/domains/analytics/utils/index.ts",
    "./calendar": "./src/domains/calendar/index.ts",
    "./calendar/hooks": "./src/domains/calendar/hooks/index.ts",
    "./calendar/services": "./src/domains/calendar/services/index.ts",
    "./calendar/types": "./src/domains/calendar/types/calendar.types.ts",
    "./calendar/utils": "./src/domains/calendar/utils/index.ts",
    "./charts": "./src/domains/charts/index.ts",
    "./chrome.css": "./src/styles/chrome.css",
    "./config": "./src/config/index.ts",
    "./layouts": "./src/domains/layouts/index.ts",
    "./layouts/components": "./src/domains/layouts/components/index.ts",
    "./layouts/hooks": "./src/domains/layouts/hooks/index.ts",
    "./layouts/theme": "./src/domains/layouts/theme/index.ts",
    "./layouts/types": "./src/domains/layouts/types/index.ts",
    "./layouts/utils": "./src/domains/layouts/utils/index.ts",
    "./modules": "./src/domains/modules/index.ts",
    "./onboarding": "./src/domains/onboarding/index.ts",
    "./organization": "./src/domains/organization/index.ts",
    "./organization/components": "./src/domains/organization/components/index.ts",
    "./package.json": "./package.json",
    "./permissions": "./src/domains/permissions/index.ts",
    "./settings": "./src/domains/settings/index.ts",
    "./settings/components": "./src/domains/settings/components/index.ts",
    "./settings/hooks": "./src/domains/settings/hooks/index.ts",
    "./settings/types": "./src/domains/settings/types/index.ts",
    "./settings/utils": "./src/domains/settings/utils/index.ts",
    "./timing": "./src/domains/timing/index.ts",
    "./timing/hooks": "./src/domains/timing/hooks/index.ts",
    "./search": "./src/domains/search/index.ts",
    "./search/utils": "./src/domains/search/searchItems.ts",
    "./styles.css": "./src/styles/dashboard.css"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "version:patch": "npm version patch -m 'chore: release v%s'",
    "version:minor": "npm version minor -m 'chore: release v%s'",
    "version:major": "npm version major -m 'chore: release v%s'"
  },
  "peerDependencies": {
    "framer-motion": "^12.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-router": "^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "framer-motion": {
      "optional": true
    }
  },
  "dependencies": {
    "lucide-react": "^0.577.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@umituz/web-design-system": "^4.29.4",
    "eslint": "^10.0.2",
    "framer-motion": "^12.23.12",
    "jsdom": "^29.1.1",
    "react-router": "^7.13.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "keywords": [
    "dashboard",
    "layout",
    "settings",
    "analytics",
    "analytics-services",
    "cohort-analysis",
    "funnel-analysis",
    "user-segmentation",
    "behavior-prediction",
    "performance-monitoring",
    "realtime-metrics",
    "calendar",
    "content-calendar",
    "scheduler",
    "content-planning",
    "drag-drop",
    "charts",
    "metrics",
    "kpi",
    "visualization",
    "svg-charts",
    "react",
    "typescript",
    "components",
    "admin",
    "sidebar",
    "header",
    "config-driven",
    "package-driven",
    "onboarding",
    "wizard",
    "product-tour"
  ],
  "author": "umituz",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umituz/web-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/umituz/web-dashboard/issues"
  },
  "homepage": "https://github.com/umituz/web-dashboard#readme"
}
