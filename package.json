{
  "name": "@umituz/web-dashboard",
  "version": "4.1.3",
  "description": "Installable app skeleton for the fleet — layouts, auth, onboarding, analytics (dependency-free SVG charts), calendar, i18n injection, permissions/session/module registry; ships its own udb-* stylesheet and --u-* tokens",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/dashboard.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./primitives": "./src/primitives/index.ts",
    "./i18n": "./src/i18n/index.ts",
    "./permissions": "./src/domains/permissions/index.ts",
    "./session": "./src/domains/session/index.ts",
    "./modules": "./src/domains/modules/index.ts",
    "./layouts": "./src/domains/layouts/index.ts",
    "./layouts/components": "./src/domains/layouts/components/index.ts",
    "./layouts/hooks": "./src/domains/layouts/hooks/index.ts",
    "./layouts/utils": "./src/domains/layouts/utils/index.ts",
    "./layouts/types": "./src/domains/layouts/types/index.ts",
    "./layouts/theme": "./src/domains/layouts/theme/index.ts",
    "./settings": "./src/domains/settings/index.ts",
    "./settings/components": "./src/domains/settings/components/index.ts",
    "./settings/hooks": "./src/domains/settings/hooks/index.ts",
    "./settings/utils": "./src/domains/settings/utils/index.ts",
    "./settings/types": "./src/domains/settings/types/index.ts",
    "./onboarding": "./src/domains/onboarding/index.ts",
    "./onboarding/components": "./src/domains/onboarding/components/index.ts",
    "./onboarding/hooks": "./src/domains/onboarding/hooks/index.ts",
    "./onboarding/utils": "./src/domains/onboarding/utils/index.ts",
    "./onboarding/types": "./src/domains/onboarding/types/index.ts",
    "./auth": "./src/domains/auth/index.ts",
    "./auth/components": "./src/domains/auth/components/index.ts",
    "./auth/hooks": "./src/domains/auth/hooks/index.ts",
    "./auth/utils": "./src/domains/auth/utils/index.ts",
    "./auth/types": "./src/domains/auth/types/index.ts",
    "./analytics": "./src/domains/analytics/index.ts",
    "./analytics/components": "./src/domains/analytics/components/index.ts",
    "./analytics/hooks": "./src/domains/analytics/hooks/index.ts",
    "./analytics/utils": "./src/domains/analytics/utils/index.ts",
    "./analytics/types": "./src/domains/analytics/types/index.ts",
    "./analytics/services": "./src/domains/analytics/services/index.ts",
    "./calendar": "./src/domains/calendar/index.ts",
    "./calendar/types": "./src/domains/calendar/types/calendar.types.ts",
    "./calendar/services": "./src/domains/calendar/services/index.ts",
    "./calendar/hooks": "./src/domains/calendar/hooks/index.ts",
    "./calendar/utils": "./src/domains/calendar/utils/index.ts",
    "./config": "./src/domain/config/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "version:patch": "npm version patch -m 'chore: release v%s'",
    "version:minor": "npm version minor -m 'chore: release v%s'",
    "version:major": "npm version major -m 'chore: release v%s'"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-router-dom": "^6.0.0 || ^7.0.0"
  },
  "dependencies": {
    "@umituz/web-design-system": "^4.0.2",
    "lucide-react": "^0.577.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.0.2",
    "react-router-dom": "^7.13.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "keywords": [
    "dashboard",
    "layout",
    "settings",
    "onboarding",
    "wizard",
    "auth",
    "authentication",
    "login",
    "register",
    "analytics",
    "analytics-services",
    "cohort-analysis",
    "funnel-analysis",
    "user-segmentation",
    "behavior-prediction",
    "performance-monitoring",
    "realtime-metrics",
    "calendar",
    "content-calendar",
    "scheduler",
    "content-planning",
    "drag-drop",
    "charts",
    "metrics",
    "kpi",
    "visualization",
    "svg-charts",
    "react",
    "typescript",
    "components",
    "admin",
    "sidebar",
    "header",
    "config-driven",
    "package-driven"
  ],
  "author": "umituz",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umituz/web-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/umituz/web-dashboard/issues"
  },
  "homepage": "https://github.com/umituz/web-dashboard#readme"
}
